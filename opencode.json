{
    "$schema": "https://opencode.ai/config.json",
    "instructions": ["INSTRUCCIONES-OPENCODE.md"],
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama local",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "qwen3.5:9b": {
                    "name": "Qwen3.5 9B local"
                }
            }
        }
    }
}